<?php
namespace Domain\{{php.namespace.host($options.backend.host)}}\Controller;

use Domain\{{php.namespace.host($options.backend.host)}}\Service\Recycle as Service;
use Exception;
use Package\Raxon\Account\Exception\AuthorizationException;
use Package\Raxon\Account\Module\Permission;
use Raxon\App;
use Raxon\Exception\ErrorException;
use Raxon\Exception\ObjectException;
use Raxon\Exception\FileWriteException;
use Raxon\Module\Core;
use Raxon\Module\Controller;
use Raxon\Module\Dir;
use Raxon\Module\File;
use Raxon\Module\Response;
use Raxon\Node\Module\Node;

class Recycle extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;

    /**
     * @throws ErrorException
     * @throws ObjectException
     * @throws AuthorizationException
     * @throws FileWriteException
     * @throws Exception
     */
    public static function bin(App $object){
        $role = Permission::controller($object, File::basename(__CLASS__), __FUNCTION__, $user);
        if($role === null){
            throw new AuthorizationException('You are not allowed to access this resource.');
        }
        if(property_exists($role, 'name') && $role->name === 'ROLE_ADMIN'){
            $dir_recycle = $object->config('project.volume.dir.recycle');
            if(!Dir::is($dir_recycle)){
                Dir::create($dir_recycle);
                File::permission($object, ['dir' => $dir_recycle]);
            }
            $dir_target = $dir_recycle . date('Ymd');
            if(!Dir::is($dir_target)){
                Dir::create($dir_target);
                File::permission($object, ['dir' => $dir_target]);
            }
            $node = new Node($object);
            $role = $node->role_system();
            $class = 'System.FileSystem.Recycle';
            $uuid = Core::uuid();
            if(Dir::is($object->request('url'))){
                $type = 'Dir';
                $target = $dir_target . DIRECTORY_SEPARATOR . $uuid . DIRECTORY_SEPARATOR;
            }
            elseif(File::is_link($object->request('url'))){
                $type = 'Link';
                $target = $dir_target . DIRECTORY_SEPARATOR . $uuid . '.link';
            }
             else {
                $type = 'File';
                $target = $dir_target . DIRECTORY_SEPARATOR . $uuid . '.data';
            }
            $attribute = [];
            $directory = explode('/', $object->request('url'));
            $end = array_pop($directory);
            if(empty($end)){
                $end = array_pop($directory);
            }
            $directory_target = '';
            foreach($directory as $part){
               $directory_target .= $part . DIRECTORY_SEPARATOR;
               $attribute[] = (object) [
                   'url' => $directory_target,
                   'owner' => File::owner($directory_target),
                   'group' => File::group($directory_target),
                   'mode' => File::mode($directory_target),
                   'type' => 'Dir'
               ];
            }
            if($type === 'File'){
                $attribute[] = (object) [
                    'url' => $object->request('url'),
                    'owner' => File::owner($object->request('url')),
                    'group' => File::group($object->request('url')),
                    'mode' => File::mode($object->request('url')),
                    'type' => 'File'
                ];
            }
            elseif($type === 'Link'){
                $attribute[] = (object) [
                    'url' => $object->request('url'),
                    'owner' => File::owner($object->request('url')),
                    'group' => File::group($object->request('url')),
                    'mode' => File::mode($object->request('url')),
                    'type' => 'Link'
                ];
            }
            elseif($type === 'Dir'){
                $attribute[] = (object) [
                    'url' => $object->request('url'),
                    'owner' => File::owner($object->request('url')),
                    'group' => File::group($object->request('url')),
                    'mode' => File::mode($object->request('url')),
                    'type' => 'Dir'
                ];
            }
            $record = (object) [
                'uuid'=> $uuid,
                'class' => $class,
                'source' => $object->request('url'),
                'attribute' => $attribute,
                'target' => $target,
                'user' => $user->uuid,
                'is' => (object) [
                    'created' => microtime(true)
                ]
            ];
            $response = $node->create($class, $role, $record);
            $record = $response['node'] ?? null;
            if($record){
                File::move($object->request('url'), $target);
            }
            return new Response(
                $response,
                Response::TYPE_JSON
            );
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function restore(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $uuid = $object->request('uuid');
            $data = (object) [];
            $record_delete = Service::restore($object, $role, $user, $uuid);
            ddd($record_delete);
            if(is_array($list_delete)){
                $data->uuid = $list_delete;
                $data->error = false;
                foreach($list_delete as $uuid => $status){
                    if($uuid === $object->request('uuid')){
                        $data->uuid = $uuid;
                    }
                    if($status === false){
                        $data->error = true;
                        break;
                    }
                }
            }
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function restore_many(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $list = $object->request('many');
            $data = (object) [];
            $list_delete = Service::restore_many($object, $role, $user, $list);
            if(is_array($list_delete)){
                $data->uuid = $list_delete;
                $data->error = false;
                foreach($list_delete as $uuid => $status){
                    if($status === false){
                        $data->error = true;
                        break;
                    }
                }
            }
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        }
    }
}
