<?php
namespace Domain\{{php.namespace.host($options.backend.host)}}\Controller;

use Domain\{{php.namespace.host($options.backend.host)}}\Service\FileSystem as Service;
use Exception;
use Package\Raxon\Account\Module\Permission;
use Raxon\App;
use Raxon\Exception\AuthorizationException;
use Raxon\Exception\UrlEmptyException;
use Raxon\Exception\ObjectException;
use Raxon\Module\Core;
use Raxon\Module\Dir;
use Raxon\Module\File;
use Raxon\Module\Response;
use Raxon\Module\Server;
use Raxon\Module\Controller;

class FileSystem extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function create(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $url = htmlspecialchars_decode($object->request('url'), ENT_HTML5);
            if(empty($url)){
                throw new UrlEmptyException('Url is empty.');
            }
            $type = $object->request('type');
            trace();
            switch($type){
                case File::TYPE:
                case Dir::TYPE:
                    break;
                default:
                    throw new Exception('Invalid type.');
            }
            $content = null;
            if($object->request('content')){
                $content = $object->request('content');
            }
            $data = Service::create($object, $role, $user, $url, $type, $content);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

        /**
         * @throws UrlEmptyException
         * @throws ObjectException
         * @throws Exception
         */
        public static function download(App $object){
            $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
            if(
                $role->name !== 'ROLE_ANONYMOUS' &&
                $user
            ){
                $url = htmlspecialchars_decode($object->request('url'), ENT_HTML5);
                if(empty($url)){
                    throw new UrlEmptyException('Url is empty.');
                }
                $type = $object->request('type');
                switch($type){
                    case File::TYPE:
                    case Dir::TYPE:
                        break;
                    default:
                        throw new Exception('Invalid type.');
                }
                $data = Service::download($object, $role, $user, $url, $type);
                return new Response(
                    $data,
                    Response::TYPE_JSON
                );
            } else {
                $token = Server::token();
                if($token){
                    throw new AuthorizationException('Invalid token.');
                } else {
                    Core::redirect("/Readme");
                }
            }
        }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function read(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $url = htmlspecialchars_decode($object->request('url'), ENT_HTML5);
            if(empty($url)){
                throw new UrlEmptyException('Url is empty.');
            }
            Service::read($object, $role, $user, $url);
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function update(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $url = htmlspecialchars_decode($object->request('url'), ENT_HTML5);
            if(empty($url)){
                throw new UrlEmptyException('Url is empty.');
            }
            $content = $object->request('content');
            $data = Service::update($object, $role, $user, $url, $content);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

