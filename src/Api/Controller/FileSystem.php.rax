        $role = Permission::controller($object, Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $url = $object->request('url');
            $data = Service::delete($object, $role, $user, $url);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function list(App $object){
        $role = Permission::controller($object, Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS'
        ){
            $type = $object->request('type');
            if(empty($type)){
                throw new Exception('Type is empty.');
            }
            $directory = $object->request('directory');
            $data = Service::list($object, $role, $user, $directory, $type);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function rename(App $object){
        $role = Permission::controller($object, Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $source = $object->request('source');
            $destination = $object->request('destination');
            $overwrite = $object->request('overwrite') ?? false;
            $data = Service::rename($object, $role, $user, $source, $destination, $overwrite);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function copy(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $source = $object->request('source');
            $destination = $object->request('destination');
            $overwrite = $object->request('overwrite') ?? false;
            $data = Service::copy(
                $object,
                $role,
                $user,
                $source,
                $destination,
                $overwrite
            );
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function upload(App $object){
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $directory = $object->request('directory');
            if(empty($directory)){
                throw new Exception('Please give a valid directory...');
            }
            $file = $object->request('file');
            if(empty($file)){
                throw new Exception('Please give a valid file...');
            }
            $type = $object->request('type');
            $data = $object->request('data');
            $message = Service::upload($object, $role, $user, $directory, $file, $data, $type);
            if(empty($message)){
                $code = 200;
            } else {
                $code = 405;
            }
            return new Response(
                $message,
                Response::TYPE_HTML,
                $code
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

    /**
     * @throws UrlEmptyException
     * @throws ObjectException
     * @throws Exception
     */
    public static function context_menu(App $object){
        return false;
        $role = Permission::controller($object,Service::NAME, __FUNCTION__, $user);
        if(
            property_exists($role, 'name') &&
            $role->name !== 'ROLE_ANONYMOUS' &&
            $user
        ){
            $data = Service::context_menu($object, $role, $user);
            return new Response(
                $data,
                Response::TYPE_JSON
            );
        } else {
            $token = Server::token();
            if($token){
                throw new AuthorizationException('Invalid token.');
            } else {
                Core::redirect("/Readme");
            }
        }
    }

}
